# syntax=docker/dockerfile:2
FROM node:20-alpine AS base
WORKDIR /app
RUN npm install -g turbo
COPY package.json turbo.json tsconfig.base.json ./
COPY apps/server/package.json apps/server/
COPY packages/shared/package.json packages/shared/
RUN npm install --omit=dev

FROM base AS builder
COPY --prune=hard ./ ./
RUN turbo run build --filter=@willyboxd/shared --filter=@willyboxd/server

FROM node:20-alpine AS runner
USER node
WORKDIR /app
COPY --from=builder --chown=node:node /app/apps/server/dist ./dist
COPY --from=builder --chown=node:node /app/apps/server/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
RUN mkdir -p /app/data
EXPOSE 3000
CMD ["node", "dist/index.js"]
